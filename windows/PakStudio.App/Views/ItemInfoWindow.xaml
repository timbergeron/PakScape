<Window x:Class="PakStudio.App.Views.ItemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, StringFormat={}{0} Info}"
        Width="500"
        Height="540"
        MinWidth="420"
        MinHeight="320"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextForegroundBrush}"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,14,7" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="InfoValueStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,22,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="64"
                            Height="64"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource MenuHoverBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="34"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="{Binding IconGlyph}" />
                            <Image Source="{Binding Thumbnail}"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="10,3,0,0"
                                VerticalAlignment="Top">
                        <TextBox Padding="0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="19"
                                 FontWeight="SemiBold"
                                 IsReadOnly="True"
                                 Text="{Binding Name}"
                                 TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="{Binding Type}" />
                    </StackPanel>
                </Grid>

                <Separator Margin="0,18" />

                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabels" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource InfoLabelStyle}" Text="Archive:" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{Binding ArchiveName}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource InfoLabelStyle}" Text="Path:" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{Binding Path}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource InfoLabelStyle}" Text="Size:" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{Binding Size}" />
                    <TextBlock Grid.Row="3"
                               Style="{StaticResource InfoLabelStyle}"
                               Text="Contents:"
                               Visibility="{Binding HasContents, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             Style="{StaticResource InfoValueStyle}"
                             Text="{Binding Contents}"
                             Visibility="{Binding HasContents, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Row="4"
                               Style="{StaticResource InfoLabelStyle}"
                               Text="Modified:"
                               Visibility="{Binding HasModified, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             Style="{StaticResource InfoValueStyle}"
                             Text="{Binding Modified}"
                             Visibility="{Binding HasModified, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <StackPanel Visibility="{Binding HasFormatDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Separator Margin="0,14,0,18" />
                    <TextBlock Margin="0,0,0,10"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Format Details" />
                    <ItemsControl ItemsSource="{Binding FormatDetails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,3,14,7"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Text="{Binding Label, StringFormat={}{0}:}" />
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InfoValueStyle}"
                                             Text="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1"
                MinWidth="88"
                Margin="0,14,0,0"
                Padding="14,6"
                HorizontalAlignment="Right"
                IsDefault="True"
                Content="Done"
                Click="DoneButton_OnClick" />
    </Grid>
</Window>
