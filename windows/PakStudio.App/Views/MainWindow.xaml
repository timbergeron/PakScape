<Window x:Class="PakStudio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PakStudio.App.Converters"
        xmlns:helpers="clr-namespace:PakStudio.App.Helpers"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewModels="clr-namespace:PakStudio.App.ViewModels"
        Title="{Binding WindowTitle}"
        Height="760"
        Width="1220"
        MinHeight="600"
        MinWidth="960"
        Closing="Window_OnClosing"
        Background="{DynamicResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Cut}"
                        CanExecute="Cut_CanExecute"
                        Executed="Cut_Executed" />
        <CommandBinding Command="{x:Static ApplicationCommands.Copy}"
                        CanExecute="Copy_CanExecute"
                        Executed="Copy_Executed" />
        <CommandBinding Command="{x:Static ApplicationCommands.Paste}"
                        CanExecute="Paste_CanExecute"
                        Executed="Paste_Executed" />
        <CommandBinding Command="{x:Static ApplicationCommands.SelectAll}"
                        CanExecute="SelectAll_CanExecute"
                        Executed="SelectAll_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewPk3Command}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding ExitCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="Enter" Command="{Binding OpenSelectedCommand}" />
        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding GetInfoCommand}" />
        <KeyBinding Key="Back" Command="{Binding UpCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ForwardCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInIconsCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control+Shift" Command="{Binding ZoomInIconsCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInIconsCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutIconsCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutIconsCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ArchiveViewModeEqualsConverter x:Key="ArchiveViewModeEqualsConverter" />
        <converters:ArchiveViewModeToVisibilityConverter x:Key="ArchiveViewModeToVisibilityConverter" />

        <Style x:Key="NavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFB1170C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailsColumnHeaderStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0,0,6,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Tag" Value="{Binding Key}" />
            <Setter Property="Content" Value="{Binding HeaderText}" />
            <Setter Property="HorizontalContentAlignment" Value="{Binding ContentAlignment}" />
            <Setter Property="ToolTip" Value="Click to sort, drag to move the column" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="1200" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Click" Handler="SortHeader_OnClick" />
            <EventSetter Event="PreviewMouseLeftButtonDown"
                         Handler="DetailsColumnHeader_OnPreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseLeftButtonUp"
                         Handler="DetailsColumnHeader_OnPreviewMouseLeftButtonUp" />
            <!-- Tunneling: ButtonBase marks the bubbling MouseMove handled while it holds capture. -->
            <EventSetter Event="PreviewMouseMove" Handler="DetailsColumnHeader_OnMouseMove" />
            <EventSetter Event="GiveFeedback" Handler="DetailsColumnHeader_OnGiveFeedback" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailsColumnSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="7" />
            <Setter Property="Margin" Value="0,0,-4,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ResizeBehavior" Value="CurrentAndNext" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="Panel.ZIndex" Value="1" />
            <Setter Property="ToolTip" Value="Drag to resize the column" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <!-- Explorer fades a hairline in at the divider while you are on it. -->
                        <Border Background="Transparent">
                            <Border x:Name="DividerLine"
                                    Width="1"
                                    Margin="0,1"
                                    Opacity="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource MutedForegroundBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DividerLine"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.8"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DividerLine"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="WrapItemsPanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="LinearItemsPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>

        <HierarchicalDataTemplate DataType="{x:Type viewModels:FolderTreeNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Path Width="16"
                      Height="13"
                      Margin="0,0,8,0"
                      Data="M 1,4 L 1,14 L 19,14 L 19,5 L 9,5 L 7,2 L 1,2 Z"
                      Fill="Transparent"
                      Stroke="{DynamicResource MutedForegroundBrush}"
                      StrokeLineJoin="Round"
                      StrokeThickness="1.25"
                      Stretch="Uniform"
                      VerticalAlignment="Center" />
                <TextBlock Text="{Binding DisplayName}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="LargeIconTemplate">
            <Border x:Name="LargeIconBorder"
                    Width="{Binding DataContext.LargeIconTileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Margin="0,0,12,12"
                    Padding="12"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <Grid Width="{Binding DataContext.LargeIconPreviewWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                          Height="{Binding DataContext.LargeIconPreviewHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                          HorizontalAlignment="Center">
                        <Image Source="{Binding Thumbnail}"
                               MaxWidth="{Binding DataContext.LargeIconPreviewWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                               MaxHeight="{Binding DataContext.LargeIconPreviewHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                               Stretch="Uniform" />
                        <TextBlock x:Name="LargeIconGlyph"
                                   Visibility="Collapsed"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{Binding DataContext.LargeIconGlyphSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="{Binding IconGlyph}" />
                        <Path x:Name="LargeFolderGlyph"
                              Width="{Binding DataContext.LargeFolderWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                              Height="{Binding DataContext.LargeFolderHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                              Visibility="Collapsed"
                              Data="M 1,4 L 1,14 L 19,14 L 19,5 L 9,5 L 7,2 L 1,2 Z"
                              Fill="Transparent"
                              Stroke="{DynamicResource MutedForegroundBrush}"
                              StrokeLineJoin="Round"
                              StrokeThickness="1.25"
                              Stretch="Uniform" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <TextBlock x:Name="LargeNameText"
                                   Tag="NameText"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="{Binding Name}" />
                        <TextBox x:Name="LargeRenameTextBox"
                                 Tag="InlineRename"
                                 Visibility="Collapsed"
                                 HorizontalContentAlignment="Center"
                                 TextAlignment="Center"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 LostKeyboardFocus="InlineRenameTextBox_OnLostKeyboardFocus"
                                 PreviewKeyDown="InlineRenameTextBox_OnPreviewKeyDown" />
                    </Grid>
                    <TextBlock Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               FontSize="11"
                               Text="{Binding SecondaryText}"
                               ToolTip="{Binding SearchPath}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                    <Setter TargetName="LargeIconGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="LargeIconGlyph" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="LargeFolderGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="LargeNameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="LargeRenameTextBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                             Value="True">
                    <Setter TargetName="LargeIconBorder"
                            Property="BorderBrush"
                            Value="{DynamicResource TextForegroundBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SmallIconTemplate">
            <Border x:Name="SmallIconBorder"
                    Margin="0,0,8,8"
                    Padding="8"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="30" Height="30" VerticalAlignment="Center">
                        <Image Source="{Binding Thumbnail}"
                               MaxWidth="30"
                               MaxHeight="30"
                               Stretch="Uniform" />
                        <TextBlock x:Name="SmallIconGlyph"
                                   Visibility="Collapsed"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="{Binding IconGlyph}" />
                        <Path x:Name="SmallFolderGlyph"
                              Width="20"
                              Height="16"
                              Visibility="Collapsed"
                              Data="M 1,4 L 1,14 L 19,14 L 19,5 L 9,5 L 7,2 L 1,2 Z"
                              Fill="Transparent"
                              Stroke="{DynamicResource MutedForegroundBrush}"
                              StrokeLineJoin="Round"
                              StrokeThickness="1.25"
                              Stretch="Uniform" />
                    </Grid>
                    <StackPanel Margin="8,0,0,0">
                        <Grid>
                            <TextBlock x:Name="SmallNameText" Tag="NameText" Text="{Binding Name}" />
                            <TextBox x:Name="SmallRenameTextBox"
                                     Tag="InlineRename"
                                     MinWidth="120"
                                     Visibility="Collapsed"
                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     LostKeyboardFocus="InlineRenameTextBox_OnLostKeyboardFocus"
                                     PreviewKeyDown="InlineRenameTextBox_OnPreviewKeyDown" />
                        </Grid>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="{Binding SecondaryText}"
                                   ToolTip="{Binding SearchPath}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                    <Setter TargetName="SmallIconGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="SmallIconGlyph" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="SmallFolderGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="SmallNameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="SmallRenameTextBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                             Value="True">
                    <Setter TargetName="SmallIconBorder"
                            Property="BorderBrush"
                            Value="{DynamicResource TextForegroundBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ListTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="20" Height="20">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                    <TextBlock x:Name="ListIconGlyph"
                               Visibility="Collapsed"
                               FontFamily="Segoe MDL2 Assets"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Text="{Binding IconGlyph}" />
                    <Path x:Name="ListFolderGlyph"
                          Width="16"
                          Height="13"
                          Visibility="Collapsed"
                          Data="M 1,4 L 1,14 L 19,14 L 19,5 L 9,5 L 7,2 L 1,2 Z"
                          Fill="Transparent"
                          Stroke="{DynamicResource MutedForegroundBrush}"
                          StrokeLineJoin="Round"
                          StrokeThickness="1.25"
                          Stretch="Uniform" />
                </Grid>
                <Grid Grid.Column="1">
                    <TextBlock x:Name="ListNameText"
                               Tag="NameText"
                               VerticalAlignment="Center"
                               Text="{Binding Name}" />
                    <TextBox x:Name="ListRenameTextBox"
                             Tag="InlineRename"
                             Visibility="Collapsed"
                             VerticalContentAlignment="Center"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             LostKeyboardFocus="InlineRenameTextBox_OnLostKeyboardFocus"
                             PreviewKeyDown="InlineRenameTextBox_OnPreviewKeyDown" />
                </Grid>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="{Binding SecondaryText}"
                           ToolTip="{Binding SearchPath}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                    <Setter TargetName="ListIconGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="ListIconGlyph" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ListFolderGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="ListNameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ListRenameTextBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DetailsTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Data.DetailsColumns[0].Width, Source={StaticResource ViewModelProxy}}"
                                      MinWidth="{Binding Data.DetailsColumns[0].MinWidth, Source={StaticResource ViewModelProxy}}" />
                    <ColumnDefinition Width="{Binding Data.DetailsColumns[1].Width, Source={StaticResource ViewModelProxy}}"
                                      MinWidth="{Binding Data.DetailsColumns[1].MinWidth, Source={StaticResource ViewModelProxy}}" />
                    <ColumnDefinition Width="{Binding Data.DetailsColumns[2].Width, Source={StaticResource ViewModelProxy}}"
                                      MinWidth="{Binding Data.DetailsColumns[2].MinWidth, Source={StaticResource ViewModelProxy}}" />
                    <ColumnDefinition Width="{Binding Data.DetailsColumns[3].Width, Source={StaticResource ViewModelProxy}}"
                                      MinWidth="{Binding Data.DetailsColumns[3].MinWidth, Source={StaticResource ViewModelProxy}}" />
                    <ColumnDefinition Width="{Binding Data.DetailsColumns[4].Width, Source={StaticResource ViewModelProxy}}"
                                      MinWidth="{Binding Data.DetailsColumns[4].MinWidth, Source={StaticResource ViewModelProxy}}" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="{Binding Data.NameColumn.DisplayIndex, Source={StaticResource ViewModelProxy}}"
                      Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                        <TextBlock x:Name="DetailsIconGlyph"
                                   Visibility="Collapsed"
                                   FontFamily="Segoe MDL2 Assets"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="{Binding IconGlyph}" />
                        <Path x:Name="DetailsFolderGlyph"
                              Width="16"
                              Height="13"
                              Visibility="Collapsed"
                              Data="M 1,4 L 1,14 L 19,14 L 19,5 L 9,5 L 7,2 L 1,2 Z"
                              Fill="Transparent"
                              Stroke="{DynamicResource MutedForegroundBrush}"
                              StrokeLineJoin="Round"
                              StrokeThickness="1.25"
                              Stretch="Uniform" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <TextBlock x:Name="DetailsNameText"
                                   Tag="NameText"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding PrimaryText}"
                                   ToolTip="{Binding SearchPath}" />
                        <TextBox x:Name="DetailsRenameTextBox"
                                 Tag="InlineRename"
                                 Visibility="Collapsed"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 LostKeyboardFocus="InlineRenameTextBox_OnLostKeyboardFocus"
                                 PreviewKeyDown="InlineRenameTextBox_OnPreviewKeyDown" />
                    </Grid>
                </Grid>
                <TextBlock Grid.Column="{Binding Data.TypeColumn.DisplayIndex, Source={StaticResource ViewModelProxy}}"
                           Margin="0,0,6,0"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding TypeText}" />
                <TextBlock Grid.Column="{Binding Data.DetailsColumn.DisplayIndex, Source={StaticResource ViewModelProxy}}"
                           Margin="0,0,6,0"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DetailsText}"
                           Text="{Binding DetailsText}" />
                <TextBlock Grid.Column="{Binding Data.SizeColumn.DisplayIndex, Source={StaticResource ViewModelProxy}}"
                           Margin="0,0,6,0"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding SizeText}" />
                <TextBlock Grid.Column="{Binding Data.ModifiedColumn.DisplayIndex, Source={StaticResource ViewModelProxy}}"
                           Margin="0,0,6,0"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding ModifiedText}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                    <Setter TargetName="DetailsIconGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="DetailsIconGlyph" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="DetailsFolderGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="DetailsNameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="DetailsRenameTextBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    <DockPanel>
        <Grid DockPanel.Dock="Top"
              Height="44"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Width="20"
                   Height="20"
                   Margin="10,0,7,0"
                   Source="/PakScape;component/Assets/PakScape.png"
                   Stretch="Uniform" />

            <Button Grid.Column="1"
                    Style="{StaticResource NavigationButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="FolderPaneToggle_OnClick"
                    ToolTip="Show or hide folders">
                <Grid Width="12" Height="10">
                    <Border BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            BorderThickness="1"
                            CornerRadius="2" />
                    <Border Width="1"
                            Margin="4,1,0,1"
                            HorizontalAlignment="Left"
                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
            </Button>

            <Button Grid.Column="2"
                    Style="{StaticResource NavigationButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{Binding BackCommand}"
                    ToolTip="Back">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="11"
                           Text="&#xE72B;" />
            </Button>

            <Button Grid.Column="3"
                    Style="{StaticResource NavigationButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{Binding ForwardCommand}"
                    ToolTip="Forward">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="11"
                           Text="&#xE72A;" />
            </Button>

            <Menu Grid.Column="4"
                  VerticalAlignment="Center"
                  Background="Transparent"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="_File">
                <MenuItem Header="New _PAK" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="New P_K3" Command="{Binding NewPk3Command}" InputGestureText="Ctrl+Shift+N" />
                <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="ToolTip" Value="{Binding}" />
                            <Setter Property="Command"
                                    Value="{Binding Data.OpenRecentCommand, Source={StaticResource ViewModelProxy}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="Open PAK _Folder" Command="{Binding OpenPakFolderCommand}" />
                <Separator />
                <MenuItem Header="_Add Files..." Command="{Binding AddFilesCommand}" />
                <MenuItem Header="Add _Folder..." Command="{Binding AddFolderCommand}" />
                <MenuItem Header="_Export Selected..." Command="{Binding ExportCommand}" />
                <Separator />
                <MenuItem Header="_Close Window"
                          Command="{Binding ExitCommand}"
                          InputGestureText="Ctrl+W" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Cu_t" Command="{x:Static ApplicationCommands.Cut}" InputGestureText="Ctrl+X" />
                <MenuItem Header="_Copy" Command="{x:Static ApplicationCommands.Copy}" InputGestureText="Ctrl+C" />
                <MenuItem Header="_Paste" Command="{x:Static ApplicationCommands.Paste}" InputGestureText="Ctrl+V" />
                <MenuItem Header="Select _All"
                          Command="{x:Static ApplicationCommands.SelectAll}"
                          InputGestureText="Ctrl+A" />
                <Separator />
                <MenuItem Header="New _Folder" Command="{Binding NewFolderCommand}" />
                <Separator />
                <MenuItem Header="_Rename" Command="{Binding RenameCommand}" InputGestureText="F2" />
                <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" InputGestureText="Delete" />
            </MenuItem>
            <MenuItem Header="_Go">
                <MenuItem Header="_Back" Command="{Binding BackCommand}" InputGestureText="Alt+Left" />
                <MenuItem Header="_Forward" Command="{Binding ForwardCommand}" InputGestureText="Alt+Right" />
                <Separator />
                <MenuItem Header="_Up One Level" Command="{Binding UpCommand}" InputGestureText="Backspace" />
                <MenuItem Header="_Open Selection" Command="{Binding OpenSelectedCommand}" InputGestureText="Enter" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Large Icons"
                          Command="{Binding ShowLargeIconsCommand}"
                          IsCheckable="True"
                          IsChecked="{Binding ActiveViewMode, Mode=OneWay, Converter={StaticResource ArchiveViewModeEqualsConverter}, ConverterParameter=LargeIcons}" />
                <MenuItem Header="_Small Icons"
                          Command="{Binding ShowSmallIconsCommand}"
                          IsCheckable="True"
                          IsChecked="{Binding ActiveViewMode, Mode=OneWay, Converter={StaticResource ArchiveViewModeEqualsConverter}, ConverterParameter=SmallIcons}" />
                <MenuItem Header="_List"
                          Command="{Binding ShowListCommand}"
                          IsCheckable="True"
                          IsChecked="{Binding ActiveViewMode, Mode=OneWay, Converter={StaticResource ArchiveViewModeEqualsConverter}, ConverterParameter=List}" />
                <MenuItem Header="_Details"
                          Command="{Binding ShowDetailsCommand}"
                          IsCheckable="True"
                          IsChecked="{Binding ActiveViewMode, Mode=OneWay, Converter={StaticResource ArchiveViewModeEqualsConverter}, ConverterParameter=Details}" />
                <Separator />
                <MenuItem Header="Zoom _In"
                          Command="{Binding ZoomInIconsCommand}"
                          InputGestureText="Ctrl++" />
                <MenuItem Header="Zoom _Out"
                          Command="{Binding ZoomOutIconsCommand}"
                          InputGestureText="Ctrl+-" />
                <Separator />
                <MenuItem Header="_Quick Preview"
                          InputGestureText="Space"
                          Click="QuickPreview_OnClick" />
                <Separator />
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" InputGestureText="F5" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About PakScape" Command="{Binding AboutCommand}" />
            </MenuItem>
            </Menu>

            <Button Grid.Column="6"
                    Style="{StaticResource CaptionButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="MinimizeWindow_OnClick"
                    ToolTip="Minimize">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="10"
                           Text="&#xE921;" />
            </Button>

            <Button Grid.Column="7"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="MaximizeWindow_OnClick"
                    ToolTip="Maximize">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="Maximized">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="10"
                           Text="&#xE922;" />
            </Button>

            <Button Grid.Column="7"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="RestoreWindow_OnClick"
                    ToolTip="Restore Down">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="Maximized">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="10"
                           Text="&#xE923;" />
            </Button>

            <Button Grid.Column="8"
                    Style="{StaticResource CloseCaptionButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseWindow_OnClick"
                    ToolTip="Close">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="10"
                           Text="&#xE8BB;" />
            </Button>
        </Grid>

        <Grid x:Name="ContentLayoutGrid" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderPaneColumn" Width="280" />
                <ColumnDefinition x:Name="FolderSplitterColumn" Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="8"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderThickness="0"
                    CornerRadius="0">
                <TreeView x:Name="FolderTree"
                          ItemsSource="{Binding FolderRoots}"
                          SelectedItemChanged="FolderTree_OnSelectedItemChanged" />
            </Border>

            <GridSplitter x:Name="FolderSplitter"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          DragCompleted="FolderSplitter_OnDragCompleted"
                          DragStarted="FolderSplitter_OnDragStarted"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <Border x:Name="ContentPaneBorder"
                    Grid.Column="2"
                    Padding="12"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="12,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Margin="0,0,0,10"
                            Padding="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Column="0"
                                  Grid.Row="0"
                                  Margin="-6,0,16,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform Y="-1" />
                                </Grid.RenderTransform>
                                <Border x:Name="ArchiveNameButton"
                                        MouseLeftButtonUp="ArchiveName_OnMouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Padding" Value="6,3" />
                                            <Setter Property="CornerRadius" Value="4" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanRenameArchive}" Value="True">
                                                    <Setter Property="ToolTip" Value="Click to rename this archive" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                                                                   Value="True" />
                                                        <Condition Binding="{Binding CanRenameArchive}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource MenuHoverBrush}" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsRenamingArchive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding ArchiveDisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <TextBox x:Name="ArchiveNameEditor"
                                         MinWidth="180"
                                         Text="{Binding ArchiveEditName, UpdateSourceTrigger=PropertyChanged}"
                                         LostKeyboardFocus="ArchiveNameEditor_OnLostKeyboardFocus"
                                         PreviewKeyDown="ArchiveNameEditor_OnPreviewKeyDown">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Padding" Value="5,2" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRenamingArchive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>

                            <Border Grid.Column="1"
                                    Grid.Row="0"
                                    Width="260"
                                    Height="32"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <TextBox x:Name="ArchiveSearchBox"
                                             Padding="10,4,34,4"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding SearchPlaceholder}" />
                                    <TextBlock Margin="11,0,34,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               IsHitTestVisible="False"
                                               Text="{Binding SearchPlaceholder}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ArchiveSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,10,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               IsHitTestVisible="False"
                                               Text="&#xE721;">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSearchActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="ClearSearch_OnClick"
                                            ToolTip="Clear search">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Width" Value="28" />
                                                <Setter Property="Height" Value="28" />
                                                <Setter Property="Margin" Value="0,0,2,0" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSearchActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Text="&#xE8BB;" />
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Grid.Row="1"
                                       Margin="2,4,0,0"
                                       HorizontalAlignment="Left"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="{Binding SearchResultText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSearchActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Grid DockPanel.Dock="Top"
                          Margin="4,0,4,8"
                          ClipToBounds="True"
                          Visibility="{Binding ActiveViewMode, Converter={StaticResource ArchiveViewModeToVisibilityConverter}, ConverterParameter=Details}">
                        <Grid x:Name="DetailsHeaderColumns"
                              Background="Transparent"
                              AllowDrop="True"
                              DragOver="DetailsHeader_OnDragOver"
                              DragLeave="DetailsHeader_OnDragLeave"
                              Drop="DetailsHeader_OnDrop"
                              Thumb.DragCompleted="DetailsHeader_OnResizeCompleted">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding DetailsColumns[0].Width, Mode=TwoWay}"
                                                  MinWidth="{Binding DetailsColumns[0].MinWidth}" />
                                <ColumnDefinition Width="{Binding DetailsColumns[1].Width, Mode=TwoWay}"
                                                  MinWidth="{Binding DetailsColumns[1].MinWidth}" />
                                <ColumnDefinition Width="{Binding DetailsColumns[2].Width, Mode=TwoWay}"
                                                  MinWidth="{Binding DetailsColumns[2].MinWidth}" />
                                <ColumnDefinition Width="{Binding DetailsColumns[3].Width, Mode=TwoWay}"
                                                  MinWidth="{Binding DetailsColumns[3].MinWidth}" />
                                <ColumnDefinition Width="{Binding DetailsColumns[4].Width, Mode=TwoWay}"
                                                  MinWidth="{Binding DetailsColumns[4].MinWidth}" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource DetailsColumnHeaderStyle}"
                                    DataContext="{Binding DetailsColumns[0]}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource DetailsColumnHeaderStyle}"
                                    DataContext="{Binding DetailsColumns[1]}" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource DetailsColumnHeaderStyle}"
                                    DataContext="{Binding DetailsColumns[2]}" />
                            <Button Grid.Column="3"
                                    Style="{StaticResource DetailsColumnHeaderStyle}"
                                    DataContext="{Binding DetailsColumns[3]}" />
                            <Button Grid.Column="4"
                                    Style="{StaticResource DetailsColumnHeaderStyle}"
                                    DataContext="{Binding DetailsColumns[4]}" />

                            <GridSplitter Grid.Column="0" Style="{StaticResource DetailsColumnSplitterStyle}" />
                            <GridSplitter Grid.Column="1" Style="{StaticResource DetailsColumnSplitterStyle}" />
                            <GridSplitter Grid.Column="2" Style="{StaticResource DetailsColumnSplitterStyle}" />
                            <GridSplitter Grid.Column="3" Style="{StaticResource DetailsColumnSplitterStyle}" />
                        </Grid>

                        <!-- Translucent copy of the header being dragged, as Explorer shows. -->
                        <Border x:Name="DetailsColumnDragGhost"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Opacity="0"
                                CornerRadius="4"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="DetailsColumnDragGhostTransform" />
                            </Border.RenderTransform>
                            <Rectangle x:Name="DetailsColumnDragGhostSurface" />
                        </Border>

                        <Border x:Name="DetailsColumnDropIndicator"
                                Width="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Opacity="0"
                                CornerRadius="1"
                                Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="DetailsColumnDropIndicatorTransform" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <Grid>
                        <ListView x:Name="ItemList"
                                  ItemsSource="{Binding CurrentItems}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  SelectionMode="Extended"
                                  SelectionChanged="ItemList_OnSelectionChanged"
                                  MouseDoubleClick="ItemList_OnMouseDoubleClick"
                                  AllowDrop="True"
                                  DragOver="ItemList_OnDragOver"
                                  Drop="ItemList_OnDrop"
                                  PreviewMouseLeftButtonDown="ItemList_OnPreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="ItemList_OnPreviewMouseLeftButtonUp"
                                  PreviewMouseWheel="ItemList_OnPreviewMouseWheel"
                                  MouseMove="ItemList_OnMouseMove"
                                  PreviewKeyDown="ItemList_OnPreviewKeyDown"
                                  PreviewMouseRightButtonDown="ItemList_OnPreviewMouseRightButtonDown"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ContextMenu>
                            <ContextMenu Opened="ItemContextMenu_OnOpened"
                                         Closed="ItemContextMenu_OnClosed">
                                <MenuItem Header="Open"
                                          Command="{Binding Data.OpenSelectedCommand, Source={StaticResource ViewModelProxy}}" />
                                <MenuItem Header="Quick Preview"
                                          InputGestureText="Space"
                                          Click="QuickPreview_OnClick" />
                                <MenuItem Header="View Skybox"
                                          Visibility="{Binding Data.HasSkyboxPreview, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          Click="ViewSkybox_OnClick" />
                                <MenuItem Header="Get Info"
                                          InputGestureText="Alt+Enter"
                                          Command="{Binding Data.GetInfoCommand, Source={StaticResource ViewModelProxy}}" />
                                <MenuItem Header="Play Demo in Browser..."
                                          Command="{Binding Data.PlayDemoInBrowserCommand, Source={StaticResource ViewModelProxy}}" />
                                <Separator />
                                <MenuItem Header="Cut"
                                          Command="{Binding Data.CutCommand, Source={StaticResource ViewModelProxy}}" />
                                <MenuItem Header="Copy"
                                          Command="{Binding Data.CopyCommand, Source={StaticResource ViewModelProxy}}" />
                                <MenuItem Header="Paste"
                                          Command="{Binding Data.PasteCommand, Source={StaticResource ViewModelProxy}}" />
                                <Separator />
                                <MenuItem Header="Add Files..."
                                          Command="{Binding Data.ContextAddFilesCommand, Source={StaticResource ViewModelProxy}}" />
                                <MenuItem Header="Add Folder..."
                                          Command="{Binding Data.ContextAddFolderCommand, Source={StaticResource ViewModelProxy}}" />
                                <MenuItem Header="New Folder"
                                          Command="{Binding Data.ContextNewFolderCommand, Source={StaticResource ViewModelProxy}}" />
                                <Separator />
                                <MenuItem Header="Export..."
                                          Command="{Binding Data.ExportCommand, Source={StaticResource ViewModelProxy}}" />
                                <MenuItem Header="Save As"
                                          Visibility="{Binding Data.HasImageSaveOptions, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <MenuItem Header="LMP..."
                                              Command="{Binding Data.SaveImageAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="lmp" />
                                    <MenuItem Header="JPEG..."
                                              Command="{Binding Data.SaveImageAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="jpg" />
                                    <MenuItem Header="PNG..."
                                              Command="{Binding Data.SaveImageAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="png" />
                                    <MenuItem Header="TGA..."
                                              Command="{Binding Data.SaveImageAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="tga" />
                                </MenuItem>
                                <MenuItem Header="Save Model Skins As"
                                          Visibility="{Binding Data.HasModelSkinSaveOptions, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <MenuItem Header="LMP..."
                                              Command="{Binding Data.SaveModelSkinAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="lmp" />
                                    <MenuItem Header="JPEG..."
                                              Command="{Binding Data.SaveModelSkinAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="jpg" />
                                    <MenuItem Header="PNG..."
                                              Command="{Binding Data.SaveModelSkinAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="png" />
                                    <MenuItem Header="TGA..."
                                              Command="{Binding Data.SaveModelSkinAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="tga" />
                                </MenuItem>
                                <MenuItem Header="Save BSP Textures As"
                                          Visibility="{Binding Data.HasBspTextureSaveOptions, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <MenuItem Header="LMP..."
                                              Command="{Binding Data.SaveBspTexturesAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="lmp" />
                                    <MenuItem Header="JPEG..."
                                              Command="{Binding Data.SaveBspTexturesAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="jpg" />
                                    <MenuItem Header="PNG..."
                                              Command="{Binding Data.SaveBspTexturesAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="png" />
                                    <MenuItem Header="TGA..."
                                              Command="{Binding Data.SaveBspTexturesAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="tga" />
                                </MenuItem>
                                <MenuItem Header="Save WAD Textures As"
                                          Visibility="{Binding Data.HasWadTextureSaveOptions, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <MenuItem Header="LMP..."
                                              Command="{Binding Data.SaveWadTexturesAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="lmp" />
                                    <MenuItem Header="JPEG..."
                                              Command="{Binding Data.SaveWadTexturesAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="jpg" />
                                    <MenuItem Header="PNG..."
                                              Command="{Binding Data.SaveWadTexturesAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="png" />
                                    <MenuItem Header="TGA..."
                                              Command="{Binding Data.SaveWadTexturesAsCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="tga" />
                                </MenuItem>
                                <MenuItem Header="Rename"
                                          Command="{Binding Data.RenameCommand, Source={StaticResource ViewModelProxy}}" />
                                <MenuItem Header="Delete"
                                          Command="{Binding Data.DeleteCommand, Source={StaticResource ViewModelProxy}}" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.Style>
                            <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                                <Setter Property="ItemsPanel" Value="{StaticResource LinearItemsPanel}" />
                                <Setter Property="ItemTemplate" Value="{StaticResource DetailsTemplate}" />
                                <Setter Property="ItemContainerStyle" Value="{StaticResource FullRowListViewItemStyle}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.ActiveViewMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="LargeIcons">
                                        <Setter Property="ItemsPanel" Value="{StaticResource WrapItemsPanel}" />
                                        <Setter Property="ItemTemplate" Value="{StaticResource LargeIconTemplate}" />
                                        <Setter Property="ItemContainerStyle" Value="{StaticResource IconListViewItemStyle}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.ActiveViewMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="SmallIcons">
                                        <Setter Property="ItemsPanel" Value="{StaticResource WrapItemsPanel}" />
                                        <Setter Property="ItemTemplate" Value="{StaticResource SmallIconTemplate}" />
                                        <Setter Property="ItemContainerStyle" Value="{StaticResource IconListViewItemStyle}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.ActiveViewMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="List">
                                        <Setter Property="ItemsPanel" Value="{StaticResource LinearItemsPanel}" />
                                        <Setter Property="ItemTemplate" Value="{StaticResource ListTemplate}" />
                                        <Setter Property="ItemContainerStyle" Value="{StaticResource FullRowListViewItemStyle}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.ActiveViewMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Details">
                                        <Setter Property="ItemsPanel" Value="{StaticResource LinearItemsPanel}" />
                                        <Setter Property="ItemTemplate" Value="{StaticResource DetailsTemplate}" />
                                        <Setter Property="ItemContainerStyle" Value="{StaticResource FullRowListViewItemStyle}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Style>
                        </ListView>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="No archive open" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="Use File &gt; Open or File &gt; New to get started." />
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Document}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <Button x:Name="FolderPaneCollapsedIndicator"
                    Grid.Column="2"
                    Width="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Panel.ZIndex="10"
                    Visibility="Collapsed"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="False"
                    Click="FolderPaneToggle_OnClick"
                    PreviewMouseLeftButtonDown="FolderPaneIndicator_OnPreviewMouseLeftButtonDown"
                    MouseMove="FolderPaneIndicator_OnMouseMove"
                    PreviewMouseLeftButtonUp="FolderPaneIndicator_OnPreviewMouseLeftButtonUp"
                    ToolTip="Drag or click to show folders">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Opacity" Value="0" />
                        <!-- No button chrome: the seam strip is invisible, the grip is the whole visual. -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <!-- The button spans the whole seam; only the centered grip is drawn. -->
                <Border Width="8"
                        Height="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Background="{DynamicResource ScrollBarThumbHoverBrush}" />
            </Button>
        </Grid>
    </DockPanel>
    </Border>
</Window>
