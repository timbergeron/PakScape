<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Referenced only for the split-bar resize cursor, which WPF does not ship. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PakScape</AssemblyName>
    <Product>PakScape</Product>
    <Title>PakScape for Windows</Title>
    <Description>A native Windows browser and editor for Quake PAK and PK3 archives.</Description>
    <Version>1.0.1</Version>
    <Authors>Tim Bergeron</Authors>
    <ApplicationIcon>Assets\PakScape.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <NativeBuildScript>$(MSBuildProjectDirectory)\..\..\native\scripts\build-windows.ps1</NativeBuildScript>
    <NativeBuildDirectory>$(MSBuildProjectDirectory)\..\..\native\build\windows\Release</NativeBuildDirectory>
    <NativeAudioLibrary>$(NativeBuildDirectory)\pakscape_audio.dll</NativeAudioLibrary>
    <NativeModelLibrary>$(NativeBuildDirectory)\pakscape_model.dll</NativeModelLibrary>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is here for one cursor, so keep its types out of the global usings;
         Application, Button, Point and friends would all become ambiguous with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PakStudio.Core\PakStudio.Core.csproj" />
    <ProjectReference Include="..\PakStudio.Formats\PakStudio.Formats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PakScape.ico" />
    <Resource Include="Assets\PakScape.png" />
    <None Update="Assets\PakScape.File.ico"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NativeAudioLibrary)"
          Link="pakscape_audio.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="'$(OS)' == 'Windows_NT'" />
    <None Include="$(NativeModelLibrary)"
          Link="pakscape_model.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="'$(OS)' == 'Windows_NT'" />
    <None Include="..\..\native\THIRD_PARTY_NOTICES.md"
          Link="THIRD_PARTY_NOTICES.md"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <NativeBuildInput Include="$(MSBuildProjectDirectory)\..\..\native\CMakeLists.txt" />
    <NativeBuildInput Include="$(MSBuildProjectDirectory)\..\..\native\src\**\*" />
    <NativeBuildInput Include="$(MSBuildProjectDirectory)\..\..\native\include\**\*" />
    <NativeBuildInput Include="$(MSBuildProjectDirectory)\..\..\native\third_party\**\*" />
    <NativeBuildInput Include="$(NativeBuildScript)" />
  </ItemGroup>

  <Target Name="BuildNativeLibraries"
          BeforeTargets="PrepareForBuild"
          Inputs="@(NativeBuildInput)"
          Outputs="$(NativeAudioLibrary);$(NativeModelLibrary)"
          Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">
    <Message Importance="High" Text="Building PakScape native libraries..." />
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(NativeBuildScript)&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="OpenTK.GLWpfControl" Version="4.3.6" />
  </ItemGroup>
</Project>
