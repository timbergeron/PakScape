[Desktop Entry]
Type=Application
Version=1.0
Name=PakScape
GenericName=Quake Archive Editor
Comment=Browse and edit Quake PAK, PK3, and KPF archives
Exec=pakscape %f
TryExec=pakscape
Icon=io.github.timbergeron.PakScape
Terminal=false
StartupNotify=true
Categories=Utility;Archiving;
MimeType=application/x-quake-pak;application/x-quake-pk3;application/x-quake-kpf;
Keywords=Quake;PAK;PK3;KPF;archive;
